@page
@model NewsModel
@{
    ViewData["Title"] = "News";
}

<h1>Latest News</h1>

<div class="news-list">
    @foreach (var article in Model.Articles)
    {
        <article class="news-card mt-3">
            <h2>@article.Title</h2>
            <p class="text-muted"><small>Published: @article.Date.ToString("dd MMM yyyy")</small></p>
            <p>@article.Summary</p>
        </article>
    }
</div>
