@page
@model MyMvcApp.Pages.Staff.IndexModel
@{
    ViewData["Title"] = "Staff Directory";
}

<div>
    <div>
        <h1>Staff Directory</h1>
        <p><a asp-page="/Staff/Create">+ Add New Staff</a></p>
    </div>

    @if (TempData["StatusMessage"] is string msg)
    {
        <div>
            @msg
        </div>
    }

    <!-- Search & Filter Form -->
    <form method="get">
        <div>
            <input type="text" asp-for="SearchTerm" placeholder="Search by name, email, or role..." />
            <select asp-for="DepartmentFilter">
                <option value="">-- All Departments --</option>
                @foreach (var dept in Model.Departments)
                {
                    <option value="@dept">@dept</option>
                }
            </select>
            <button type="submit">Filter</button>
            <a asp-page="/Staff/Index">Reset</a>
        </div>
    </form>

    <p>Total Active Employees: <strong>@Model.ActiveCount</strong></p>

    <table>
        <thead>
            <tr>
                <th>ID</th>
                <th>Name</th>
                <th>Email</th>
                <th>Department</th>
                <th>Job Title</th>
                <th>Salary</th>
                <th>Status</th>
                <th>Actions</th>
            </tr>
        </thead>
        <tbody>
            @if (!Model.StaffList.Any())
            {
                <tr>
                    <td colspan="8">No staff members found matching your query.</td>
                </tr>
            }
            else
            {
                @foreach (var member in Model.StaffList)
                {
                    <tr>
                        <td>@member.StaffId</td>
                        <td>@member.FirstName @member.LastName</td>
                        <td>@member.Email</td>
                        <td>@member.Department</td>
                        <td>@member.JobTitle</td>
                        <td>@member.Salary.ToString("C")</td>
                        <td>
                            @if (member.IsActive == 1)
                            {
                                <span>Active</span>
                            }
                            else
                            {
                                <span>Inactive</span>
                            }
                        </td>
                        <td>
                            <a asp-page="/Staff/Details" asp-route-id="@member.StaffId">Details</a> |
                            <a asp-page="/Staff/Edit" asp-route-id="@member.StaffId">Edit</a> |
                            <a asp-page="/Staff/Delete" asp-route-id="@member.StaffId">Delete</a>
                        </td>

                    </tr>
                }
            }
        </tbody>
    </table>
</div>
