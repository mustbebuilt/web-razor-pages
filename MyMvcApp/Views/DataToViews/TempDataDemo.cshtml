<h1>@ViewData["Title"]</h1>

<p>TempData is useful for one-time messages that need to survive a redirect.</p>

@if (TempData["StatusMessage"] is string message)
{
    <p><strong>@message</strong></p>
}

<form asp-action="SetTempDataMessage" method="post">
    <button type="submit">Set TempData message</button>
</form>

<p>When you click the button, the controller stores a message in TempData and redirects back to this page.</p>