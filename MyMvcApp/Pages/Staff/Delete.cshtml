@page "{id:int}"
@model MyMvcApp.Pages.Staff.DeleteModel
@{
    ViewData["Title"] = "Delete Staff Member";
}

<div>
    <h1>Confirm Deletion</h1>
    <p>Are you sure you want to delete the following staff record?</p>

    <dl>
        <dt>ID</dt>
        <dd>@Model.Staff.StaffId</dd>

        <dt>Name</dt>
        <dd>@Model.Staff.FirstName @Model.Staff.LastName</dd>

        <dt>Email</dt>
        <dd>@Model.Staff.Email</dd>

        <dt>Department</dt>
        <dd>@Model.Staff.Department</dd>

        <dt>Job Title</dt>
        <dd>@Model.Staff.JobTitle</dd>
    </dl>

    <form method="post">
        <input type="hidden" asp-for="Staff.StaffId" />
        <button type="submit">Yes, Delete Staff Member</button>
        <a asp-page="/Staff/Index">Cancel</a>
    </form>
</div>
