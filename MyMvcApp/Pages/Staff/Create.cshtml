@page
@model MyMvcApp.Pages.Staff.CreateModel
@{
    ViewData["Title"] = "Add New Staff Member";
}

<div>
    <h1>Add New Staff Member</h1>
    <p>Fill out the form below to create a new staff record.</p>

    <form method="post">
        <div asp-validation-summary="ModelOnly"></div>

        <div>
            <label asp-for="Staff.FirstName">First Name</label>
            <input asp-for="Staff.FirstName" />
            <span asp-validation-for="Staff.FirstName"></span>
        </div>

        <div>
            <label asp-for="Staff.LastName">Last Name</label>
            <input asp-for="Staff.LastName" />
            <span asp-validation-for="Staff.LastName"></span>
        </div>

        <div>
            <label asp-for="Staff.Email">Email Address</label>
            <input asp-for="Staff.Email" type="email" />
            <span asp-validation-for="Staff.Email"></span>
        </div>

        <div>
            <label asp-for="Staff.Department">Department</label>
            <input asp-for="Staff.Department" />
            <span asp-validation-for="Staff.Department"></span>
        </div>

        <div>
            <label asp-for="Staff.JobTitle">Job Title</label>
            <input asp-for="Staff.JobTitle" />
            <span asp-validation-for="Staff.JobTitle"></span>
        </div>

        <div>
            <label asp-for="Staff.Salary">Annual Salary (£)</label>
            <input asp-for="Staff.Salary" type="number" step="0.01" />
            <span asp-validation-for="Staff.Salary"></span>
        </div>

        <div>
            <label asp-for="Staff.IsActive">Status</label>
            <select asp-for="Staff.IsActive">
                <option value="1">Active</option>
                <option value="0">Inactive</option>
            </select>
        </div>

        <div>
            <button type="submit">Create Staff Member</button>
            <a asp-page="/Staff/Index">Cancel</a>
        </div>
    </form>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
